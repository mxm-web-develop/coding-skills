{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxm-web-develop/coding-skills/schemas/profile-confirmation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "work_id": {
      "$ref": "common.schema.json#/$defs/workItemId"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "reviewer",
    "work_id",
    "confirmed_at",
    "sources"
  ]
}
