{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxm-web-develop/coding-skills/schemas/plan.schema.json",
  "title": "AI Flow Delivery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "goal_id", "status", "title", "milestones", "work_item_ids", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/planId" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "goal_id": { "$ref": "common.schema.json#/$defs/goalId" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "title": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "outcome", "requirement_ids", "exit_gates"],
        "properties": {
          "id": { "type": "string", "pattern": "^MS-[A-Za-z0-9._-]+$" },
          "title": { "$ref": "common.schema.json#/$defs/nonEmpty" },
          "outcome": { "$ref": "common.schema.json#/$defs/nonEmpty" },
          "requirement_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/requirementId" }, "uniqueItems": true },
          "exit_gates": { "$ref": "common.schema.json#/$defs/stringList" },
          "target_release": { "type": "string" }
        }
      }
    },
    "work_item_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/workItemId" }, "uniqueItems": true },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
