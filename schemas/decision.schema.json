{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxm-web-develop/coding-skills/schemas/decision.schema.json",
  "title": "AI Flow Architecture Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "status", "title", "context", "options", "decision", "consequences", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/decisionId" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "title": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "context": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "goal_id": { "type": ["string", "null"], "pattern": "^GOAL-[0-9]{8}-[a-f0-9]{8}$" },
    "requirement_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/requirementId" }, "uniqueItems": true },
    "work_item_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/workItemId" }, "uniqueItems": true },
    "options": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "tradeoffs"], "properties": { "name": { "$ref": "common.schema.json#/$defs/nonEmpty" }, "tradeoffs": { "$ref": "common.schema.json#/$defs/stringList" } }, "additionalProperties": false } },
    "decision": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "consequences": { "$ref": "common.schema.json#/$defs/stringList" },
    "rollback": { "type": "string" },
    "sources": { "$ref": "common.schema.json#/$defs/stringList" },
    "supersedes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/decisionId" }, "uniqueItems": true },
    "superseded_by": { "type": ["string", "null"], "pattern": "^ADR-[0-9]{8}-[a-f0-9]{8}$" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
