{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxm-web-develop/coding-skills/schemas/decision.schema.json",
  "title": "AI Flow Architecture Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "status", "title", "context", "decision", "consequences", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/decisionId" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "title": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "context": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "decision_type": { "type": "string", "enum": ["backend-technology", "architecture", "data", "api", "frontend-ux-ui", "cross-cutting", "other"] },
    "goal_id": { "type": ["string", "null"], "pattern": "^GOAL-[0-9]{8}-[a-f0-9]{8}$" },
    "requirement_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/requirementId" }, "uniqueItems": true },
    "work_item_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/workItemId" }, "uniqueItems": true },
    "evaluation_criteria": { "$ref": "common.schema.json#/$defs/stringList" },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "tradeoffs"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/nonEmpty" },
          "tradeoffs": { "$ref": "common.schema.json#/$defs/stringList" },
          "summary": { "type": "string" },
          "strengths": { "$ref": "common.schema.json#/$defs/stringList" },
          "weaknesses": { "$ref": "common.schema.json#/$defs/stringList" },
          "project_fit": { "type": "string" },
          "risks": { "$ref": "common.schema.json#/$defs/stringList" },
          "adoption_impact": { "type": "string" },
          "migration_impact": { "type": "string" },
          "operating_impact": { "type": "string" },
          "testing_impact": { "type": "string" },
          "rollback": { "type": "string" },
          "prototype_path": { "type": ["string", "null"] },
          "prototype_focus": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "recommended_option": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "recommendation_reason": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "confirmation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "confirmed", "declined", "revisit"] },
        "selected_option": { "type": ["string", "null"] },
        "feedback": { "type": "string" },
        "confirmed_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "decision": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "consequences": { "$ref": "common.schema.json#/$defs/stringList" },
    "rollback": { "type": "string" },
    "sources": { "$ref": "common.schema.json#/$defs/stringList" },
    "supersedes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/decisionId" }, "uniqueItems": true },
    "superseded_by": { "type": ["string", "null"], "pattern": "^ADR-[0-9]{8}-[a-f0-9]{8}$" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "required": ["decision_type"] },
      "then": {
        "required": ["decision_type", "evaluation_criteria", "options", "recommended_option", "recommendation_reason", "confirmation"]
      }
    },
    {
      "if": {
        "properties": { "decision_type": { "const": "frontend-ux-ui" } },
        "required": ["decision_type"]
      },
      "then": {
        "properties": {
          "options": { "minItems": 2, "maxItems": 3 }
        }
      }
    }
  ]
}
