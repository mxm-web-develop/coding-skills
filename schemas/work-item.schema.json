{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxm-web-develop/coding-skills/schemas/work-item.schema.json",
  "title": "AI Flow Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "kind", "title", "status", "priority", "requirement_ids", "acceptance_criteria", "scope", "evidence_ids", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/workItemId" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "kind": { "type": "string", "enum": ["feature", "bug", "refactor", "test", "docs", "research", "chore"] },
    "title": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "status": { "type": "string", "enum": ["draft", "ready", "in_progress", "blocked", "ready_for_review", "done", "cancelled"] },
    "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "goal_id": { "type": ["string", "null"], "pattern": "^GOAL-[0-9]{8}-[a-f0-9]{8}$" },
    "requirement_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/requirementId" }, "uniqueItems": true },
    "acceptance_criteria": { "$ref": "common.schema.json#/$defs/stringList" },
    "scope": { "$ref": "common.schema.json#/$defs/stringList" },
    "owner": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"], "pattern": "^RUN-[0-9]{8}-[a-f0-9]{8}$" },
    "evidence_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidenceId" }, "uniqueItems": true },
    "blocked_reason": { "type": ["string", "null"] },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
